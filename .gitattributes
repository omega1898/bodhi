# Large binary files go to Git LFS (Large File Storage): git keeps a small pointer,
# and the real file is stored separately. Run `git lfs install` once on each Mac or PC.
# Text files (C++, Markdown, CMake) stay in normal git so changes show line by line.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text
*.fbx    filter=lfs diff=lfs merge=lfs -text
*.png    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
*.exr    filter=lfs diff=lfs merge=lfs -text
*.wav    filter=lfs diff=lfs merge=lfs -text
*.blend  filter=lfs diff=lfs merge=lfs -text
*.psd    filter=lfs diff=lfs merge=lfs -text

# This test file holds a Windows line ending and an escape code on purpose.
# -text stops git from "fixing" those bytes on any computer.
core/tests/playthroughs/hostile_input.txt -text
