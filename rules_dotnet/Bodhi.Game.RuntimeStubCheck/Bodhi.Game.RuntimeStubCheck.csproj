<!-- Purpose: a stand-in compile check for the Unity scene scripts (game/Runtime) and Editor
     scripts (game/Editor). Unity isn't
     available in the cloud, so this compiles those scripts against UnityStandIns.cs: tiny
     hand-written copies of only the Unity types and calls the scripts use. It catches typos,
     wrong names and wrong use of the game's own Logic code. It does NOT prove the scripts
     compile in real Unity (the stand-ins could differ from Unity's real ones); only opening the
     project in Unity on the Mac does that. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CS0649: the stand-ins' fields are never set; that's expected of stand-ins. -->
    <NoWarn>CS0649;CS0067</NoWarn>
    <!-- Compile the iOS-only Editor code too, as Unity does when the build target is iPhone. -->
    <DefineConstants>$(DefineConstants);UNITY_IOS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../rules/Runtime/**/*.cs" Link="Rules/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../game/Logic/**/*.cs" Link="Logic/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The 3D scenes (World/, Title/, Characters/) use far more of Unity than these stand-ins
         copy: meshes, lights, particles, post-processing. Copying all of that would be a lot of
         pretend code that could drift from the real thing, so they're left out here and checked
         by compiling the real Unity project on the Mac (unity/, see unity/Assets/Editor/). The
         rest of Runtime only sees TitleWorld, which TitleStandIns.cs stands in for. -->
    <Compile Include="../../game/Runtime/**/*.cs" Exclude="../../game/Runtime/World/**;../../game/Runtime/Title/**;../../game/Runtime/Characters/**" Link="Runtime/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../game/Editor/**/*.cs" Link="Editor/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
