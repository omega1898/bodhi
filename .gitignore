# Build output from the core library. It is regenerated from the source by building.
core/build*/

# Folders Unreal Engine regenerates. Committing them bloats the repo and causes conflicts.
unreal/**/Binaries/
unreal/**/Intermediate/
unreal/**/Saved/
unreal/**/DerivedDataCache/
unreal/**/.vs/
unreal/**/*.xcworkspace
unreal/**/*.xcodeproj



# Personal reference photos and videos of real people and pets. Never commit these.
references/

# macOS folder metadata.
.DS_Store

# What `dotnet build` and `dotnet test` write for the C# rules. Regenerated on every build.
rules_dotnet/**/bin/
rules_dotnet/**/obj/
rules_dotnet/**/TestResults/
audio_preview/
__pycache__/

# Xcode's per-user files, in the Xcode project Unity writes when it builds for iOS.
xcuserdata/
