# Build output from the core library. It is regenerated from the source by building.
core/build*/

# Folders Unreal Engine regenerates. Committing them bloats the repo and causes conflicts.
unreal/**/Binaries/
unreal/**/Intermediate/
unreal/**/Saved/
unreal/**/DerivedDataCache/
unreal/**/.vs/
unreal/**/*.xcworkspace
unreal/**/*.xcodeproj

# The iOS app's generated files: the copied game, the Xcode project XcodeGen makes from
# ios/project.yml, its Info.plist, and Xcode's per-user files.
ios/UntilWeFindHome/Game/
ios/*.xcodeproj/
ios/UntilWeFindHome/Info.plist
xcuserdata/

# Screenshots the browser playtest writes on every run.
prototype/web/tests/screenshots/

# Personal reference photos and videos of real people and pets. Never commit these.
references/

# macOS folder metadata.
.DS_Store
